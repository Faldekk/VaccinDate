<Window x:Class="Vaccindate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccindate"
        Height="720"
        Width="960"
        MinHeight="650"
        MinWidth="850"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <!-- TOP MENU -->
        <Menu Grid.Row="0"
      Background="White"
      BorderBrush="#E2E8F0"
      BorderThickness="0 0 0 10"
      Padding="4">

            <MenuItem Header="About"
              Click="AboutMenuItem_Click"
                      FontSize="10"/>
        </Menu>
        <!-- HEADER -->
        <Border Grid.Row="1"
                Background="#1E293B"
                CornerRadius="16"
                Padding="18"
                Margin="10 0 10 14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Vaccindate"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Kalkulator orientacyjnego harmonogramu szczepień"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               Margin="0 4 0 0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#334155"
                        CornerRadius="10"
                        Padding="14 8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Prototype"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- INPUT -->
        <!-- INPUT -->
        <Border Grid.Row="2"
        Background="White"
        CornerRadius="16"
        Padding="18"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        Margin="10 0 10 14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="348"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- DATE -->
                <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0" Height="75">

                    <TextBlock Text="Data urodzenia"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0 0 0 8"/>
                    <DatePicker x:Name="BirthDatePicker"
                        Width="280"
                        Height="50"
                        FontSize="16"/>
                </StackPanel>

                <!-- FILTER -->
                <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0" Height="57">

                    <TextBlock Text="Filtr szczepień"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 8"/>

                    <ComboBox x:Name="VaccineFilterComboBox"
                      Width="224"
                      Height="31"
                      FontSize="15"
                      SelectedIndex="0">
                        <ComboBoxItem Content="Wszystkie"/>
                        <ComboBoxItem Content="Dzieci i młodzież"/>
                        <ComboBoxItem Content="Dorośli"/>
                        <ComboBoxItem Content="Cykliczne"/>
                        <ComboBoxItem Content="Sezonowe"/>
                        <ComboBoxItem Content="Obowiązkowe PL"/>
                    </ComboBox>
                </StackPanel>

                <!-- BUTTONS -->
                <!-- BUTTONS -->
                <StackPanel Grid.Column="2"
            VerticalAlignment="Center" Height="95">

                    <Button Content="Pokaż"
            Click="CheckVaccinationButton_Click"
            Width="140"
            Margin="0 0 0 15"/>

                    <Button Content="Wyczyść"
            Click="ClearButton_Click"
            Width="140"
            Background="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>



        <!-- RESULTS -->

        <Grid Grid.Row="3"
             Margin="10 0 10 14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAST -->
            <Border Grid.Column="0"
            Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                    Background="#FEF2F2"
                    CornerRadius="16 16 0 0"
                    Padding="16 10"
                    BorderBrush="#FECACA"
                    BorderThickness="0 0 0 1">

                        <StackPanel>
                            <TextBlock Text="Powinny już być"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#991B1B"/>

                            <TextBlock Text="Szczepienia według harmonogramu do obecnego wieku"
                               FontSize="12"
                               Foreground="#7F1D1D"
                               Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="PastResultsTextBox"
                     Grid.Row="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="16"
                     Text="Tutaj pojawią się szczepienia, które osoba powinna już mieć."/>
                </Grid>
            </Border>

            <!-- FUTURE -->
            <Border Grid.Column="2"
            Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                    Background="#EFF6FF"
                    CornerRadius="16 16 0 0"
                    Padding="16 10"
                    BorderBrush="#DBEAFE"
                    BorderThickness="0 0 0 1">

                        <StackPanel>
                            <TextBlock Text="Przyszłe"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                            <TextBlock Text="Nadchodzące i cykliczne szczepienia"
                               FontSize="12"
                               Foreground="#1E40AF"
                               Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="FutureResultsTextBox"
                     Grid.Row="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="16"
                     Text="Tutaj pojawią się przyszłe szczepienia."/>
                </Grid>
            </Border>

        </Grid>


        <!-- FOOTER -->
        <!-- FOOTER -->
        <Border Grid.Row="4"
        Background="#FEF3C7"
        BorderBrush="#F59E0B"
        BorderThickness="1"
        CornerRadius="12"
        Padding="10"
        VerticalAlignment="Stretch"
         Margin="10 0 10 5">

            <TextBlock TextWrapping="Wrap"
               Foreground="#78350F"
               FontSize="12"
               VerticalAlignment="Center">
        <Run Text="Uwaga: " FontWeight="Bold"/>
        <Run Text="aplikacja pokazuje orientacyjny harmonogram szczepień. Nie potwierdza wykonania szczepienia i nie zastępuje konsultacji medycznej."/>
            </TextBlock>
        </Border>

    </Grid>
</Window>