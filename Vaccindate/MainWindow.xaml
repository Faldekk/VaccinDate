<Window x:Class="Vaccindate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccindate"
        Height="720"
        Width="900"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="16"
                Padding="20"
                Margin="0 0 0 14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Vaccindate"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Kalkulator orientacyjnego harmonogramu szczepień"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               Margin="0 4 0 0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#334155"
                        CornerRadius="10"
                        Padding="14 8"
                        VerticalAlignment="Center">
                    <TextBlock Text="WPF / C#"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- INPUT CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="16"
                Padding="20"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Margin="0 0 0 14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT DESCRIPTION -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0 0 20 0">

                    <TextBlock Text="Wybierz datę urodzenia"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Aplikacja wypisze szczepienia, które osoba powinna już mieć oraz szczepienia przyszłe."
                               FontSize="13"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0 6 0 0"/>
                </StackPanel>

                <!-- DATE BOX ON RIGHT -->
                <Border Grid.Column="1"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="Data urodzenia"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 8"/>

                        <DatePicker x:Name="BirthDatePicker"
                                    Width="220" Height="49"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Content="Pokaż szczepienia"
                        Click="CheckVaccinationButton_Click"
                        Margin="16 0 0 0"
                        Width="170"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="Wyczyść"
                        Click="ClearButton_Click"
                        Margin="10 0 0 0"
                        Width="105"
                        Background="#64748B"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- RESULTS CARD -->
        <!-- RESULTS CARD -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAST / ALREADY DUE -->
            <Border Grid.Column="0"
            Background="White"
            CornerRadius="16"
            Padding="0"
            BorderBrush="#E2E8F0"
            BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                    Background="#FEF2F2"
                    CornerRadius="16 16 0 0"
                    Padding="16 10"
                    BorderBrush="#FECACA"
                    BorderThickness="0 0 0 1">

                        <StackPanel>
                            <TextBlock Text="Powinny już być"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#991B1B"/>

                            <TextBlock Text="Szczepienia według harmonogramu do obecnego wieku"
                               FontSize="12"
                               Foreground="#7F1D1D"
                               Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="PastResultsTextBox"
                     Grid.Row="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="White"
                     Padding="16"
                     Text="Tutaj pojawią się szczepienia, które osoba powinna już mieć."/>
                </Grid>
            </Border>

            <!-- FUTURE -->
            <Border Grid.Column="2"
            Background="White"
            CornerRadius="16"
            Padding="0"
            BorderBrush="#E2E8F0"
            BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                    Background="#EFF6FF"
                    CornerRadius="16 16 0 0"
                    Padding="16 10"
                    BorderBrush="#DBEAFE"
                    BorderThickness="0 0 0 1">

                        <StackPanel>
                            <TextBlock Text="Przyszłe"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                            <TextBlock Text="Nadchodzące i cykliczne szczepienia"
                               FontSize="12"
                               Foreground="#1E40AF"
                               Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="FutureResultsTextBox"
                     Grid.Row="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="White"
                     Padding="16"
                     Text="Tutaj pojawią się przyszłe szczepienia."/>
                </Grid>
            </Border>

        </Grid>

        <!-- FOOTER WARNING -->
        <Border Grid.Row="3"
                Background="#FEF3C7"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0 12 0 0">

            <TextBlock TextWrapping="Wrap"
                       Foreground="#78350F"
                       FontSize="12">
                <Run Text="Uwaga: " FontWeight="Bold"/>
                <Run Text="aplikacja pokazuje orientacyjny harmonogram szczepień na podstawie daty urodzenia. Nie potwierdza wykonania szczepienia i nie zastępuje konsultacji medycznej."/>
            </TextBlock>
        </Border>

    </Grid>
</Window>