<Window x:Class="Vaccindate.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przypomnienie o szczepieniu"
        Height="520"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid Margin="24">

        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Czy chcesz otrzymać przypomnienie?"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="VaccinationInfoTextBlock"
                           Text="Najbliższe szczepienie:"
                           FontSize="14"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           Margin="0 10 0 20"/>

                <TextBlock Text="Imię użytkownika"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="NameTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="10"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Adres e-mail"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="10"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Data przypomnienia"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0 0 0 6"/>

                <DatePicker x:Name="ReminderDatePicker"
                            Height="38"
                            FontSize="14"
                            Margin="0 0 0 22"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Nie teraz"
                            Width="110"
                            Height="38"
                            Background="#64748B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CancelButton_Click"
                            Margin="0 0 10 0"/>

                    <Button Content="Zapisz przypomnienie"
                            Width="170"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>